# ─── Auth.js (admin dashboard sign-in) ───────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com → APIs & Services
# → Credentials → Create Credentials → OAuth client ID → Web application.
# Authorized redirect URI: https://tristategrillcleaning.com/api/auth/callback/google
# (plus your Vercel preview domain if you want admin to work on previews).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated list of Google account emails allowed into /admin.
# Everyone else who signs in gets bounced back to the sign-in page.
ADMIN_EMAILS=jeff@cincygrillcleaning.com,jason@example.com

# ─── Google Sheets (CRM read access) ─────────────────────────
# API key from https://console.cloud.google.com → APIs & Services
# → Credentials → Create Credentials → API key.
# Restrict to the Google Sheets API and to your production domain.
# The sheet must be set to "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_ID=18DaRXOuAI8VjYd1qrpy-rr9SoOTi57VpfPOx05aolCo

# ─── AI Preview (existing) ───────────────────────────────────
# Required for /preview to work. Set in production only.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Optional: Vercel team/project slugs for the Traffic tab ─
# Used to deep-link to your Vercel Analytics dashboard. Leave blank to
# fall back to https://vercel.com/dashboard.
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_SLUG=tsgc-gallery

# ─── Optional: Apps Script override ──────────────────────────
# Defaults to SITE.quoteEndpoint in lib/site.ts (the existing lead intake).
# Override only if you deploy a separate Apps Script for event logging.
APPS_SCRIPT_URL=

# ─── iMessage → booking calendar sync ────────────────────────
# The Mac relay in /imessage-relay polls chat.db and POSTs new
# conversations here. The webhook classifies the stage via Claude and,
# only on a fresh "confirmed" transition, pings Jeff with a one-tap
# link to add the booking to the TSGC schedule calendar.

# Shared HMAC secret between the Mac relay and /api/imessage/ingest.
# Generate with: openssl rand -base64 48
# MUST match the value the Mac relay's .env has.
IMESSAGE_RELAY_SECRET=

# Signs the one-tap confirm tokens embedded in push notifications.
# Generate with: openssl rand -base64 48
IMESSAGE_CONFIRM_SECRET=

# Optional — explicit origin for confirm URLs (e.g. https://tristategrillcleaning.com).
# Defaults to the request's own host. Set this if you want the notification
# link to point at the production domain regardless of which preview URL
# the relay hit.
APP_ORIGIN=

# ── Notification provider (pick ONE) ──
# Pushover: paid, more reliable iOS delivery, supports URL action.
# https://pushover.net → create an app → copy both values.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ntfy: free, install ntfy iOS app, subscribe to your topic.
# Use a hard-to-guess topic name; it acts as the auth.
# https://ntfy.sh
NTFY_TOPIC=
# Defaults to https://ntfy.sh; override only if self-hosting.
NTFY_SERVER=
# Optional bearer token if you protect the topic.
NTFY_TOKEN=
