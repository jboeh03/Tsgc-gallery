# ─── Admin dashboard sign-in ─────────────────────────────────
# /admin is gated by a single shared password (auth.ts). Leave blank
# to use the hard-coded fallback in auth.ts ('cincygrills'). Override
# here when you rotate. Rotating invalidates every existing session
# because the cookie HMAC key is derived from the password.
ADMIN_PASSWORD=

# ─── Google Sheets (CRM read access) ─────────────────────────
# API key from https://console.cloud.google.com → APIs & Services
# → Credentials → Create Credentials → API key.
# Restrict to the Google Sheets API and to your production domain.
# The sheet must be set to "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_ID=18DaRXOuAI8VjYd1qrpy-rr9SoOTi57VpfPOx05aolCo

# Legacy Squarespace lead intake sheet — historical record from the
# pre-2024 site. Scanned by the lead qualifier so returning customers
# from the old site still count as "returning". Must also be set to
# "Anyone with the link can view" for the API key to read it. Leave
# blank to disable.
LEGACY_LEAD_SHEET_ID=1rv50ne0bFi84I9EEsZEjpo5JOwyNimyGK0EEIM_MxOI
# Optional override — if the Squarespace response tab has a specific
# name (e.g. "Form 1"). Leave blank to auto-detect the first non-hidden
# tab.
LEGACY_LEAD_SHEET_TAB=

# ─── AI Preview (existing) ───────────────────────────────────
# Required for /preview to work. Set in production only.
# ANTHROPIC_API_KEY is also used by the SMS comms hub to draft replies.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Supabase (system of record for the comms hub) ───────────
# Project: tri-state-grill (ref eetzayxxasfkunijofxg).
# Service-role key is SECRET and server-only — Settings → API → service_role.
SUPABASE_URL=https://eetzayxxasfkunijofxg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Twilio (two-way SMS) ────────────────────────────────────
# Account SID + auth token from the Twilio console. TWILIO_PHONE_NUMBER is the
# new Tri-State number (E.164, e.g. +1513…) that 657-831-4276 forwards to.
# Point the number's inbound webhook at https://<host>/api/sms (POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15137904040
# A2P 10DLC Messaging Service (preferred sender — routes via the registered campaign).
TWILIO_MESSAGING_SERVICE_SID=
# Optional: pin the exact public webhook URL if signature validation fails
# behind a proxy (otherwise derived from forwarded headers).
TWILIO_WEBHOOK_URL=
# Safety: auto-send AI drafts without a human click. Leave UNSET (human-in-the-loop).
# AUTO_SEND_SMS=

# ─── Optional: Vercel team/project slugs for the Traffic tab ─
# Used to deep-link to your Vercel Analytics dashboard. Leave blank to
# fall back to https://vercel.com/dashboard.
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_SLUG=tsgc-gallery

# ─── Optional: Apps Script override ──────────────────────────
# Defaults to SITE.quoteEndpoint in lib/site.ts (the existing lead intake).
# Override only if you deploy a separate Apps Script for event logging.
APPS_SCRIPT_URL=

# ─── iMessage → booking calendar sync ────────────────────────
# The Mac relay in /imessage-relay polls chat.db and POSTs new
# conversations here. The webhook classifies the stage via Claude and,
# only on a fresh "confirmed" transition, pings Jeff with a one-tap
# link to add the booking to the TSGC schedule calendar.

# Shared HMAC secret between the Mac relay and /api/imessage/ingest.
# Generate with: openssl rand -base64 48
# MUST match the value the Mac relay's .env has.
IMESSAGE_RELAY_SECRET=

# Signs the one-tap confirm tokens embedded in push notifications.
# Generate with: openssl rand -base64 48
IMESSAGE_CONFIRM_SECRET=

# Optional — explicit origin for confirm URLs (e.g. https://tristategrillcleaning.com).
# Defaults to the request's own host. Set this if you want the notification
# link to point at the production domain regardless of which preview URL
# the relay hit.
APP_ORIGIN=

# ── Notification provider (pick ONE) ──
# Pushover: paid, more reliable iOS delivery, supports URL action.
# https://pushover.net → create an app → copy both values.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ntfy: free, install ntfy iOS app, subscribe to your topic.
# Use a hard-to-guess topic name; it acts as the auth.
# https://ntfy.sh
NTFY_TOPIC=
# Defaults to https://ntfy.sh; override only if self-hosting.
NTFY_SERVER=
# Optional bearer token if you protect the topic.
NTFY_TOKEN=
