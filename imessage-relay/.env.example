# TSGC iMessage relay — copy to .env and fill in.
# This file lives only on the Mac running the relay; it never gets committed.

# Webhook URL on your deployed Next.js app.
TSGC_INGEST_URL=https://tristategrillcleaning.com/api/imessage/ingest

# Shared HMAC secret. MUST exactly match IMESSAGE_RELAY_SECRET on Vercel.
# Generate with: openssl rand -base64 48
IMESSAGE_RELAY_SECRET=

# How often to poll chat.db. 15s is the default; faster ⇒ snappier alerts
# but more CPU/disk. Apple's Messages app doesn't notice.
POLL_INTERVAL_MS=15000

# How many trailing messages of context to send per ingest call.
# Bigger = better classifier accuracy on long quote threads, smaller = cheaper.
CONTEXT_MESSAGE_COUNT=30

# Maximum size of an image attachment we'll inline (bytes). Larger images
# are referenced by filename only — Claude won't "see" them.
ATTACHMENT_MAX_BYTES=1048576

# Where to keep the per-chat watermark state (last rowid sent, last stage).
# Defaults to ./state.db next to relay.js. Persist across reboots.
STATE_DB=./state.db

# Override the chat.db path. Defaults to ~/Library/Messages/chat.db.
# CHAT_DB=

# On first run, catch up inbound messages from the last N hours. Set to 0
# (default) to start from "now" and only see genuinely new traffic.
STARTUP_BACKFILL_HOURS=0

# Optional safety: restrict the relay to a known set of customer numbers
# (E.164 format, comma-separated). Useful when testing — leave blank for
# all conversations.
# ALLOWED_CHAT_PHONES=+15135551234,+15135559876

# Set to 1 for verbose logs (per-tick chat counts, attachment misses, etc.)
# DEBUG=1
