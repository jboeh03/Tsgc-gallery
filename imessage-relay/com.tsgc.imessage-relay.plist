<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd plist for the TSGC iMessage relay.

  Install:
    1. Edit the paths below — replace YOUR_USERNAME and the absolute path
       to relay.js with your own.
    2. Copy to ~/Library/LaunchAgents/
    3. launchctl load -w ~/Library/LaunchAgents/com.tsgc.imessage-relay.plist
    4. tail ~/Library/Logs/tsgc-imessage-relay.log to confirm it's running.

  Notes:
    - KeepAlive restarts the relay if it crashes; throttled to 30s.
    - RunAtLoad starts it on login.
    - EnvironmentVariables is a fallback — prefer .env in the working
      directory (the relay supports both via the shell-launched node).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tsgc.imessage-relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>cd /Users/YOUR_USERNAME/tsgc-imessage-relay &amp;&amp; set -a &amp;&amp; [ -f .env ] &amp;&amp; . ./.env &amp;&amp; set +a &amp;&amp; exec /usr/local/bin/node relay.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/tsgc-imessage-relay</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/tsgc-imessage-relay.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/tsgc-imessage-relay.log</string>
</dict>
</plist>
